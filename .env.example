# Telegram-токен бота из BotFather (обязательно для assistant_bot.py)
ASSISTANT_TELEGRAM_TOKEN=

# Cloudflare Workers AI (текст + картинки + vision), бесплатно, без карты
# Вариант А: User API Token (права Account > Workers AI > Edit) — достаточно его
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Вариант Б (опционально): Global API Key вместо User Token
CLOUDFLARE_EMAIL=
CLOUDFLARE_GLOBAL_KEY=
# Текстовая модель Cloudflare по умолчанию
CLOUDFLARE_TEXT_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# Brave Search API (бесплатно 2000 запросов/мес, без карты): https://api.search.brave.com/
# Если задан — поиск идёт через Brave (стабильно), иначе fallback на DuckDuckGo.
BRAVE_API_KEY=
