# Telegram-токен бота из BotFather (обязательно для assistant_bot.py)
ASSISTANT_TELEGRAM_TOKEN=

# Cloudflare Workers AI (текст + картинки + vision), бесплатно, без карты
# Вариант А: User API Token (права Account > Workers AI > Edit) — достаточно его
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Вариант Б (опционально): Global API Key вместо User Token
CLOUDFLARE_EMAIL=
CLOUDFLARE_GLOBAL_KEY=
# Текстовая модель Cloudflare по умолчанию
CLOUDFLARE_TEXT_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# Поисковые API (бесплатные тарифы, без карты). Достаточно задать ОДИН из ключей — код выберет его.
# Приоритет: TAVILY_API_KEY > SERPAPI_KEY > BRAVE_API_KEY. Если ни один не задан — fallback на DuckDuckGo.
# Tavily: https://tavily.com  (1000 запросов/мес, AI-поиск, чистые результаты)
TAVILY_API_KEY=
# SerpAPI: https://serpapi.com (100 запросов/мес, Google-результаты)
SERPAPI_KEY=
# Brave: https://api.search.brave.com/ (2000 запросов/мес)
BRAVE_API_KEY=
